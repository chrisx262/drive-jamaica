# Drive Jamaica — Vite environment variables
# Copy this file to .env.local for local development overrides.
# VITE_* variables are injected into the frontend bundle by Vite.

# WebSocket server URL for ambient multiplayer.
# In dev mode, defaults to ws://localhost:8080 if this is unset.
# In production, set this to your deployed WS server (e.g. fly.io):
#   VITE_WS_URL=wss://drive-jamaica-ws.fly.dev
VITE_WS_URL=
