# Drive Jamaica — frontend environment variables
# Copy this file to .env.local (gitignored) and fill in your values.
# Vite injects VITE_* vars at build time.

# WebSocket server URL for ambient multiplayer.
# Dev: leave unset — the client falls back to ws://localhost:8080 automatically.
# Prod: set to your deployed Fly.io server URL (see server/fly.toml).
VITE_WS_URL=wss://drive-jamaica-ws.fly.dev
